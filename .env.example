# NST Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required for AI Notes and Active Recall features.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required for accounts and hosted persistence. On Vercel, copy the Supabase
# Transaction pooler URI (port 6543) from the project's Connect dialog.
DATABASE_URL=
# DATABASE_POOL_SIZE=1

# Used once to provision the two accounts. Use different values (8–128 chars),
# deploy, sign in, then remove these variables and redeploy.
AADARSH_INITIAL_PASSWORD=
RITHIKA_INITIAL_PASSWORD=

# Optional: change the API server port (default: 3001)
# API_PORT=3001
