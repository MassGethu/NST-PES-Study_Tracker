# NST Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required for AI Notes and Active Recall features.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required: PostgreSQL connection string (server-side only).
DATABASE_URL=
# Optional if your database requires unencrypted connections (local development).
# DATABASE_SSL=false

# Bootstrap the two named accounts once. Use different passwords, 8–128 characters.
# Existing sole legacy account keeps its ID and all data, and becomes Aadarsh.
# Subsequent starts never reset existing passwords; remove these after setup.
AADARSH_INITIAL_PASSWORD=
RITHIKA_INITIAL_PASSWORD=

# Optional: change the API server port (default: 3001)
# API_PORT=3001
